// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SYSTEM
  USER
  WAITER
  ADMIN
  MEDIA_MANAGER
  SECURITY
  CASHIER
  SUPER_ADMIN
}

enum Gender {
  M
  F
}

enum Tier {
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model User {
  id                         String                     @id @default(uuid())
  email                      String                     @unique
  password                   String
  firstName                  String
  lastName                   String
  role                       Role                       @default(USER)
  phoneNumber                String?
  gender                     Gender                     @default(M)
  tier                       Tier                       @default(SILVER)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  memberTransactionHistories MemberTransactionHistory[]
}

enum MembershipType {
  REGULAR
  VIP
}

enum MembershipStatus {
  ACTIVE
  REJECTED
  SUSPENDED
  EXPIRED
}

enum MembershipDuration {
  MONTH
  QUARTER
  YEAR
}

model MembershipApplication {
  id String @id @default(cuid())

  membershipType MembershipType

  // Personal Information
  fullName String
  email    String @unique

  cprId        String?
  nationality  String?
  dateOfBirth  DateTime?
  mobileNumber String?

  // Emergency Contact
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactMobileNumber String?

  seen Boolean @default(false)

  membership Membership?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id String @id @default(uuid())

  // Membership Details
  membershipUid    Int                @unique @default(autoincrement())
  startDate        DateTime           @map("membershipStartDate") @db.Date
  expiryDate       DateTime           @map("membershipExpiryDate") @db.Date
  duration         MembershipDuration
  membershipNumber Int                @unique @default(autoincrement())

  // VOTLO Internal Data 
  applicationReceivedBy      String?
  membershipNumberIssued     String?
  membershipCardSerialNumber String?
  approvalBy                 String?
  dateApproved               DateTime @default(now()) @db.Date
  remarks                    String?

  status MembershipStatus @default(ACTIVE)

  memberTransactionHistory MemberTransactionHistory[]

  balance Float @default(0)

  currentPeriodEnd DateTime

  membershipApplicationId String                @unique
  membershipApplication   MembershipApplication @relation(fields: [membershipApplicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransactionType {
  REDEEM
  RENEWAL
  EARN
}

model MemberTransactionHistory {
  id String @id @default(uuid())

  amount          Float
  transactionType TransactionType
  note            String?

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  performedById String
  performedBy   User   @relation(fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([membershipId])
}

model Worker {
  id         Int      @id @default(autoincrement())
  name       String
  occupation String
  ranking    Int      @default(0) // positive number, default 0
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum EntityType {
  USER
  PRODUCT
  ARTICLE
  EVENT
  GALLERY
}

enum MediaStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum MediaPurpose {
  AVATAR
  IMAGE
  THUMBNAIL
  VIDEO
}

model Media {
  s3Key        String      @id
  originalName String
  fileType     String
  mimeType     String
  fileSize     Int?
  status       MediaStatus @default(PENDING)

  entityType   EntityType
  entityId     String?
  mediaPurpose MediaPurpose // 'avatar', 'gallery', 'thumbnail'

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?

  // @@unique([entityType, entityId, mediaPurpose])
  @@index([entityType, entityId])
  @@index([entityType, entityId, mediaPurpose])
}

enum EventType {
  WEEKLY
  SPECIAL
}

model Event {
  id            String    @id @default(uuid())
  name          String    @unique
  type          EventType
  description   String
  startDate     DateTime?
  endDate       DateTime?
  cronStartDate String?
  cronEndDate   String?
  isLadiesNight Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isLadiesNight])
}

enum EventAssiciated {
  LadiesNight
  SpinnigWheel
}

model Stats {
  id                String          @id @default(uuid())
  event             EventAssiciated
  date              DateTime
  totalParticipants Int
  drinksConsumed    Int
  quota             Int
}

model SpinningWheel {
  id        String   @id @default(cuid())
  name      String?
  isActive  Boolean  @default(false)
  startDate DateTime
  endDate   DateTime

  rewardList SpinningWheelReward[]

  @@map("spinning_wheel_events")
}

model SpinningWheelReward {
  id      String        @id @default(cuid())
  name    String
  wheelId String
  event   SpinningWheel @relation(fields: [wheelId], references: [id], onDelete: Cascade)

  @@map("spinning_wheel_rewards")
}

enum GalleryTags {
  SPECIAL_EVENTS
  VIBES
  FOOD
  LADIES_NIGHT
}

model Gallery {
  id  String      @id @default(cuid())
  tag GalleryTags

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LadiesNightData {
  id                               String   @id @default(cuid())
  startDate                        DateTime @unique
  totalParticipants                Int
  participantWithAllRedeemedDrinks Int
  totalDrinksConsumed              Int
  drinkQuota                       Int
}

model SpinningWheelData {
  id                       String   @id @default(cuid())
  startDate                DateTime @unique
  totalParticipants        Int
  participantsRedeemedCode Int
}

model appSettings {
  id    String @id @default(cuid())
  field String @unique
  value String

  @@index([field])
}
