:3000 {

    handle /socket.io/* {
        reverse_proxy api:3000
    }

    # -----------------------
    # API reverse proxy
    # -----------------------
    handle /api/* {
        reverse_proxy api:3000
    }


    # -----------------------
    # Well-known files
    # -----------------------
    handle /.well-known/* {
        root * /srv/.well-known
        file_server
    }

    
    # -----------------------
    # Web SPA
    # -----------------------
    handle {
        root * /srv/web
        encode gzip
        file_server
        try_files {path} /index.html
    }

    log {
		level ERROR
        format console
    }
}

# -----------------------
# Admin panel
# -----------------------
:3001 {
    root * /srv/admin
    encode gzip
    file_server
    try_files {path} /index.html

    log {
		level ERROR
        format console
    }
}
