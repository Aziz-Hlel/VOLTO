FROM node:22.14.0-alpine AS deps
ARG API_PATH=apps/api
RUN corepack enable
RUN corepack prepare pnpm@latest --activate
WORKDIR /app

COPY ${API_PATH}/package.json ./${API_PATH}/package.json
COPY ${API_PATH}/pnpm-lock.yaml ./${API_PATH}/pnpm-lock.yaml
COPY ${API_PATH}/pnpm-workspace.yaml ./${API_PATH}/pnpm-workspace.yaml

COPY ${API_PATH}/prisma ./${API_PATH}/prisma/
COPY shared ./shared/  

WORKDIR /app/${API_PATH}
RUN pnpm install --frozen-lockfile

FROM node:22.14.0-alpine AS builder
ARG API_PATH=apps/api
RUN corepack enable
RUN corepack prepare pnpm@latest --activate
WORKDIR /app

# Copy node_modules from deps stage
COPY --from=deps /app/${API_PATH}/node_modules ./${API_PATH}/node_modules
COPY --from=deps /app/node_modules ./node_modules

# Copy source code
COPY shared ./shared/
COPY ${API_PATH} ./${API_PATH}/

WORKDIR /app/${API_PATH}
RUN pnpm prisma generate  # This is probably what's missing
COPY ${API_PATH} .
RUN pnpm run build

FROM node:22.14.0-alpine AS runner
ARG API_PATH=apps/api
RUN corepack enable && corepack prepare pnpm@latest --activate
RUN addgroup -S nodejs && adduser -S nodejs -G nodejs
WORKDIR /app

COPY --from=deps /app/${API_PATH}/node_modules ./${API_PATH}/node_modules
COPY --from=builder /app/${API_PATH}/dist ./${API_PATH}/dist/
COPY --from=builder /app/${API_PATH}/prisma ./${API_PATH}/prisma/

COPY ${API_PATH}/public ./${API_PATH}/public/

WORKDIR /app/${API_PATH}
USER nodejs
CMD ["node", "dist/main.js"]